{ config, lib, pkgs, ... }:

let
  # Only in the 26.11 tree; 26.05 has no tidal-cycles-full. Not pkgs.tidal, which is the
  # TIDAL streaming client.
  tidal = pkgs.unstable.tidal-cycles-full;
in
{
  config = lib.mkIf pkgs.stdenv.isLinux {
    home.packages = [ tidal ];

    xdg.configFile = {
      # Start script for `superdirt-start`; the package default is a bare `SuperDirt.start;`,
      # which does not raise numWireBufs.
      "tidal/boot.scd".text = ''
        // SuperDirt.start raises numBuffers, memSize and maxNodes and boots the server
        // itself. numWireBufs is the one limit it leaves at the default (64).
        s.options.numWireBufs = 256;

        SuperDirt.start;
      '';

      # Read by home/development/nvim/lua/plugins/tidal.lua. Lives beside init.lua, not
      # under nvim/lua, which is a single store symlink.
      "nvim/tidal-paths.lua".text = ''
        -- Generated by home/apps/livecoding.nix
        return {
          ghci = "${tidal.passthru.ghcWithTidal}/bin/ghci",
          boot = "${tidal.passthru.tidalBoot}/share/tidal-cycles/BootTidal.hs",
          sclang = "${tidal}/bin/sclang-with-superdirt",
          boot_scd = "${config.xdg.configHome}/tidal/boot.scd",
        }
      '';
    };
  };
}
