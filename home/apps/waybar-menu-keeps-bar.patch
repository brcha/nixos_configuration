Keep a bar visible while one of its menus is open: a hide request (from
on-sigusr1/on-sigusr2 or a toggle) is ignored while a menu attached to the
bar, such as a tray menu, is mapped. The menu is a popup surface of its own,
so hiding the bar would leave it floating over nothing. A later hide request
works once the menu has closed.

--- a/src/bar.cpp
+++ b/src/bar.cpp
@@ -663,7 +663,29 @@
 }
 #endif
 
+// A menu attached to a widget of the bar (a tray menu) is open. A GtkMenu
+// lives in a popup toplevel of its own; submenus need no check, since their
+// parent menu stays open with them.
+static bool hasOpenMenu(GtkWidget* bar_window) {
+  GList* toplevels = gtk_window_list_toplevels();
+  bool open = false;
+  for (GList* l = toplevels; l != nullptr && !open; l = l->next) {
+    GtkWidget* child = gtk_bin_get_child(GTK_BIN(l->data));
+    if (child != nullptr && GTK_IS_MENU(child) && gtk_widget_get_mapped(GTK_WIDGET(l->data))) {
+      GtkWidget* attach = gtk_menu_get_attach_widget(GTK_MENU(child));
+      open = attach != nullptr && gtk_widget_get_toplevel(attach) == bar_window;
+    }
+  }
+  g_list_free(toplevels);
+  return open;
+}
+
 void waybar::Bar::setVisible(bool value) {
+  // Hidden, the bar would leave its open menu floating over nothing
+  if (!value && hasOpenMenu(GTK_WIDGET(window.gobj()))) {
+    spdlog::debug("Bar for output {} stays visible while a menu is open", output->name);
+    return;
+  }
   visible = value;
   if (auto mode = config.get("mode", {}); mode.isString()) {
     setMode(visible ? config["mode"].asString() : MODE_INVISIBLE);
